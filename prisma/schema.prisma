// this is the prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Form {
  id          String @default(cuid()) @id
  user        User? @relation(fields: [userId], references: [id])
  userId      String?
  positive    Int
  good        Int
  pleasant    Int
  happy       Int
  joyful      Int
  contented   Int
  negative    Int
  bad         Int
  unpleasant  Int
  sad         Int
  afraid      Int
  angry       Int
}

model User {
  id          String    @default(cuid()) @id
  name        String?
  email       String?   @unique
  role        String?
  forms       Form[]
  @@map(name: "users")
}